# OpenRouter configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=AGI Race

# Force all in-game requests onto the proxy model by default
LLM_PROXY_MODEL=google/gemini-3-flash
LLM_PROXY_FORCE_MODEL=1
LLM_PROXY_REASONING_EFFORT=low
VITE_GAMEMASTER_MODEL=google/gemini-3-flash
LLM_PROXY_PORT=8787
LLM_PROXY_CORS_ORIGIN=*
VITE_LLM_PROXY_URL=http://localhost:8787/api/llm
